{
  "name": "gocamp-migration-staging",
  "main": "workers/app.ts",
  "compatibility_date": "2026-10-31",
  "workers_dev": true,
  "vars": { "GOCAMP_ENV": "staging" },
  "d1_databases": [
    { "binding": "DB", "database_name": "gocamp-staging-db", "database_id": "87e579d7-4f7a-4673-a317-d62551858b3c", "migrations_dir": "server/db/migrations" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "gocamp-staging-media" }
  ]
}
