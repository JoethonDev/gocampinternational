{
  "name": "gocamp-cloudflare-app",
  "description": "GoCamp International React Router application on Cloudflare Workers",
  "cloudflare": {
    "label": "React Router Framework Starter",
    "products": [
      "Workers"
    ],
    "categories": [
      "storage"
    ],
    "preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/36a99c4a-8919-4e6e-ac9e-e55974407200/public",
    "preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/65455e96-7992-425f-44e4-30f3e7d7f900/preview",
    "publish": true
  },
  "dependencies": {
    "isbot": "5.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@react-router/dev": "8.5.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "wrangler": "4.158.0"
  },
  "private": true,
  "scripts": {
    "dev": "npm run assets:prepare && node scripts/verify-no-static-media.mjs && react-router dev",
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "build": "npm run assets:prepare && react-router build && node scripts/verify-no-static-media.mjs",
    "typegen": "react-router typegen",
    "typecheck": "react-router typegen && tsc -b",
    "check": "npm test && npm run typecheck && npm run build && wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types && react-router typegen",
    "smoke:staging": "node scripts/smoke-staging.mjs",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"workers/**/*.ts\" \"scripts/**/*.mjs\" \"tests/*.mjs\" \"*.ts\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css}\" \"workers/**/*.ts\" \"scripts/**/*.mjs\" \"tests/*.mjs\" \"*.ts\"",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <23"
  }
}
