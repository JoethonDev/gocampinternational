{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gocamp-migration-production",
  "main": "./workers/app.ts",
  "upload_source_maps": true,
  "compatibility_date": "2026-10-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 0.1
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 0.1
    }
  },
  "vars": {
    "GOCAMP_ENV": "production",
    "MIGRATION_SOURCE_SHA": "a60979165e236d4113b625d3166cef21919d7337",
    "ANALYTICS_ENABLED": "true",
    "ANALYTICS_PRIVACY_NOTICE_PUBLISHED": "false",
    "WEB_ANALYTICS_SITE_TAG": "0d6871ab70ca418c98118754b828d53b"
  },
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gocamp-production-db",
      "database_id": "84f3beb7-ed00-49eb-a25b-913b301ad1da",
      "migrations_dir": "server/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "gocamp-production-media"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": [
      "/images/*",
      "/uploads/*",
      "/media/*",
      "/robots.txt",
      "/sitemap.xml",
      "/llms.txt"
    ]
  },
  "preview_urls": false,
  "routes": [
    {
      "pattern": "gocampinternational.net",
      "custom_domain": true
    },
    {
      "pattern": "www.gocampinternational.net",
      "custom_domain": true
    }
  ]
}
